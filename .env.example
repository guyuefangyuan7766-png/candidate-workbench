# OpenAI-compatible model gateway. Leave unset to keep the assistant disabled.
AGENT_BASE_URL=https://gateway.example.com/v1
AGENT_API_KEY=
AGENT_MODEL=

# Hybrid search is enabled only for an explicitly prepared dataset.
# Keep false until real-data processing and index maintenance are scheduled.
SEARCH_REMOTE_ENABLED=false
SEARCH_QUERY_MODEL=qwen3.8-flash
SEARCH_QUERY_REASONING_EFFORT=none
SEARCH_QUERY_TIMEOUT_MS=12000
SEARCH_EMBEDDING_MODEL=text-embedding-v4
SEARCH_EMBEDDING_DIMENSIONS=1024
SEARCH_RERANK_MODEL=qwen3-rerank
SEARCH_VECTOR_DIRECTORY=
SEARCH_VECTOR_MAINTENANCE_ENABLED=false
SEARCH_VECTOR_MAINTENANCE_CONCURRENCY=4
SEARCH_VECTOR_MAINTENANCE_INTERVAL_MS=300000
SEARCH_MODEL_ALLOWED_HOSTS=
SEARCH_MODEL_TRUSTED_PRIVATE_HOSTS=

# Attachment text-model output remains strict by default. Set compat only for
# an explicitly approved gateway that cannot accept strict JSON Schema; local
# schema, field, evidence, and value validation remains mandatory.
# ATTACHMENT_TEXT_SCHEMA_MODE=strict
# ATTACHMENT_TEXT_TIMEOUT_MS=60000
# ATTACHMENT_TEXT_MAX_RESPONSE_BYTES=524288
# Optional exact DNS hostnames approved to resolve only to company-private
# addresses for the text gateway. Requires HTTPS and never accepts IP literals
# or wildcard/suffix matches.
# ATTACHMENT_TEXT_TRUSTED_PRIVATE_HOSTS=text.corp.example

# Controlled PDF page-vision channel. Keep disabled unless the approved
# OpenAI-compatible gateway and model support image input.
ATTACHMENT_VISUAL_CAPABILITY=disabled
# ATTACHMENT_VISUAL_SCHEMA_MODE=strict
# Set all three visual values together, or leave all three unset to reuse the
# Agent gateway above after explicitly changing the capability to image_input.
# ATTACHMENT_VISUAL_BASE_URL=https://gateway.example.com/v1
# Optional comma-separated hostname allowlist for the visual gateway.
# ATTACHMENT_VISUAL_ALLOWED_HOSTS=gateway.example.com
# Optional exact DNS hostnames approved to resolve only to company-private
# addresses. This never permits private IP literals, wildcard/suffix matches,
# reserved .localhost/.internal/.local or metadata names, non-HTTPS endpoints,
# or dangerous/reserved DNS answers.
# ATTACHMENT_VISUAL_TRUSTED_PRIVATE_HOSTS=vision.corp.example
# ATTACHMENT_VISUAL_API_KEY=
# ATTACHMENT_VISUAL_MODEL=
# ATTACHMENT_VISUAL_TIMEOUT_MS=15000
# ATTACHMENT_VISUAL_MAX_PAGES=12
# ATTACHMENT_VISUAL_MAX_PAGE_PIXELS=4000000
# ATTACHMENT_VISUAL_MAX_PAGE_BYTES=3145728
# ATTACHMENT_VISUAL_MAX_TOTAL_IMAGE_BYTES=12582912
# ATTACHMENT_VISUAL_MAX_TEXT_CHARACTERS=8000
# ATTACHMENT_VISUAL_MAX_RECORDS=100
# ATTACHMENT_VISUAL_MAX_RESPONSE_BYTES=524288

# Optional runtime settings.
PORT=4173
HOST=127.0.0.1

# ---- LDAP 统一认证（2026-09-21 第十五轮）-------------------------------
# 默认关闭：AUTH_ENABLED 未设为 true 时，服务保持个人回环模式、不要求登录，
# 行为与本次改造之前完全一致。
AUTH_ENABLED=false

# 公司 LDAP。当前环境没有 LDAPS，使用 389 明文；代码保留 ldaps:// 支持。
LDAP_URL=ldap://ldap.wan5d.com:389
# %s 会被替换为登录时输入的账号（已确认 DN 形如 cn=zhangsan,ou=People,...）
LDAP_USER_DN_TEMPLATE=cn=%s,ou=People,dc=wooduan,dc=com
LDAP_UID_ATTRIBUTE=uid
# 明文连接必须显式接受；具备 LDAPS/STARTTLS 后改为 false
LDAP_ALLOW_PLAINTEXT=true
# off = 显示名使用登录账号（第一版确认行为）
# anonymous = 额外尝试匿名读取目录属性，失败自动降级、不影响登录
LDAP_ATTRIBUTE_LOOKUP=off
LDAP_NAME_ATTRIBUTE=cn
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_TIMEOUT_MS=8000

# 账号白名单：正式名单放在 data/auth-allowlist.txt，服务每 30 秒重读，
# 编辑后无需重启。该环境变量仅作名单文件缺失时的启动引导值。
# AUTH_ALLOWED_USERS=zhangsan,lisi
# AUTH_ALLOWLIST_FILE=D:\talent-data\auth-allowlist.txt

# 会话。HTTPS 部署必须把 AUTH_COOKIE_SECURE 设为 true。
AUTH_SESSION_TTL_MS=43200000
AUTH_SESSION_ABSOLUTE_TTL_MS=2592000000
AUTH_COOKIE_SECURE=false
# 反向代理部署置 true；无代理时开启会让客户端可伪造来源地址
AUTH_TRUST_PROXY=false
# AUTH_DB_PATH=D:\talent-data\auth.db

# 登录限流：账号 5 次 / 5 分钟为主防线，来源地址 30 次 / 1 分钟为次级防线
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_MS=300000
AUTH_LOGIN_IP_RATE_LIMIT=30
AUTH_LOGIN_IP_RATE_WINDOW_MS=60000

# 受控网络监听。本次部署由反向代理提供 HTTPS，应用保持回环绑定，
# 以下两项保持关闭；只有需要应用直接监听内网地址时才配置。
AUTH_ALLOW_NON_LOOPBACK=false
AUTH_BIND_HOSTS=127.0.0.1,::1

# Optional data location. Set only one; DB_PATH takes precedence.
# APP_DATA_DIR=C:\RecruitmentData
# DB_PATH=C:\RecruitmentData\recruitment.db
# Node 24: read Windows system root certificates for internal HTTPS gateways.
NODE_USE_SYSTEM_CA=1
